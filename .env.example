# ── Supabase (المشروع المتصل: LAPASSIIOON's Project) ──
# القيم العامة (آمنة للعرض في المتصفح):
NEXT_PUBLIC_SUPABASE_URL=https://ngyhplcnmedafjzotgho.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon_key_من_لوحة_Supabase>

# ── مفتاح الخدمة (سرّي — للخادم فقط، لا يُكشف للمتصفح أبدًا) ──
# يُستخدم فقط في عمليات الخادم (server actions / route handlers).
SUPABASE_SERVICE_ROLE_KEY=<service_role_key_سرّي>

# ── البريد (Resend) ──
RESEND_API_KEY=<resend_key>

# ── حماية النماذج (Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<turnstile_site_key>
TURNSTILE_SECRET_KEY=<turnstile_secret>
